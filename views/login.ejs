<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Food Hub | เข้าสู่ระบบ &amp; สมัครสมาชิก</title>
    <link rel="icon" href="/assets/Gemini_Generated_Image_ydjf53ydjf53ydjf.jpeg">
    <link rel="stylesheet" href="/bootstrap/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include('partials/navbar', { activePage: 'login', currentUser }) %>

    <!-- Main Auth Section -->
    <main class="auth-section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10 col-xl-9">
                    <div class="auth-card">
                        <div class="row g-0">

                            <!-- Showcase Panel -->
                            <div class="col-md-5 auth-showcase">
                                <div>
                                    <span class="badge bg-light text-dark rounded-pill px-3 py-2 mb-3 fw-normal">🍲 Food Hub Member</span>
                                    <h2 class="fw-bold mb-2">รสชาติไทยแท้<br>พร้อมเสิร์ฟถึงบ้าน</h2>
                                    <p class="small opacity-75 mb-4">สมัครสมาชิกฟรี เพื่อสั่งอาหารได้รวดเร็วยิ่งขึ้นและรับสิทธิพิเศษสำหรับสมาชิก</p>
                                    <img src="/assets/tomyum.jpg" alt="ต้มยำกุ้ง Food Hub" class="auth-showcase-img mb-4 shadow-sm">
                                </div>

                                <ul class="auth-feature-list">
                                    <li><span>✓</span> สั่งเมนูไทยยอดฮิตได้ในไม่กี่คลิก</li>
                                    <li><span>✓</span> บันทึกข้อมูลเพื่อการสั่งซื้อครั้งถัดไป</li>
                                    <li><span>✓</span> ตรวจสอบข้อมูลโภชนาการครบทุกเมนู</li>
                                </ul>
                            </div>

                            <!-- Form Panel -->
                            <div class="col-md-7 auth-form-panel">

                                <!-- Already Logged In View -->
                                <div id="loggedInCard" class="text-center py-4 <%= currentUser ? '' : 'd-none' %>">
                                    <div class="fs-1 mb-2">👋</div>
                                    <h3 class="fw-bold mb-1">เข้าสู่ระบบอยู่แล้ว</h3>
                                    <p class="text-muted mb-3">
                                        สวัสดีคุณ <strong id="loggedInUserName"><%= currentUser ? currentUser.name : '' %></strong>
                                        (<span id="loggedInUserEmail"><%= currentUser ? currentUser.email : '' %></span>)
                                    </p>
                                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-2 mt-4">
                                        <a href="/#menu" class="btn btn-order-thai px-4 py-2">ไปหน้าสั่งอาหาร</a>
                                        <button type="button" class="btn btn-outline-danger px-4 py-2 rounded-3" onclick="logoutUser()">ออกจากระบบ</button>
                                    </div>
                                </div>

                                <!-- Login / Register Wrapper -->
                                <div id="authFormsWrapper" class="<%= currentUser ? 'd-none' : '' %>">
                                    <div class="auth-tabs mb-4" role="tablist">
                                        <button type="button" class="auth-tab-btn <%= mode !== 'register' ? 'active' : '' %>" id="loginTabBtn" onclick="switchAuthMode('login')">
                                            เข้าสู่ระบบ
                                        </button>
                                        <button type="button" class="auth-tab-btn <%= mode === 'register' ? 'active' : '' %>" id="registerTabBtn" onclick="switchAuthMode('register')">
                                            สมัครสมาชิกใหม่
                                        </button>
                                    </div>

                                    <div class="mb-3">
                                        <h3 class="fw-bold mb-1" id="authHeading"><%= mode === 'register' ? 'สมัครสมาชิกใหม่' : 'ยินดีต้อนรับกลับมา' %></h3>
                                        <p class="text-muted small mb-0" id="authSubheading"><%= mode === 'register' ? 'สร้างบัญชี Food Hub เพื่อสั่งอาหารและรับสิทธิพิเศษ' : 'เข้าสู่ระบบเพื่อสั่งอาหารจานโปรดของคุณ' %></p>
                                    </div>

                                    <!-- Alert Feedback -->
                                    <div id="authAlert" class="d-none" role="alert"></div>

                                    <!-- Login Form -->
                                    <form id="loginForm" class="<%= mode === 'register' ? 'd-none' : '' %>" onsubmit="handleLogin(event)" novalidate>
                                        <div class="mb-3">
                                            <label for="loginEmail" class="form-label fw-medium small">อีเมล</label>
                                            <input type="email" class="form-control auth-input" id="loginEmail" name="email" placeholder="name@example.com" autocomplete="email" required>
                                        </div>

                                        <div class="mb-3">
                                            <label for="loginPassword" class="form-label fw-medium small">รหัสผ่าน</label>
                                            <div class="input-group">
                                                <input type="password" class="form-control auth-input" id="loginPassword" name="password" placeholder="กรอกรหัสผ่านของคุณ" autocomplete="current-password" required>
                                                <button class="btn password-toggle-btn" type="button" aria-label="แสดงรหัสผ่าน" onclick="togglePasswordVisibility('loginPassword', this)">👁️</button>
                                            </div>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center mb-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="rememberMe" checked>
                                                <label class="form-check-label small text-muted" for="rememberMe">
                                                    จดจำฉันไว้ในระบบ
                                                </label>
                                            </div>
                                        </div>

                                        <button type="submit" class="btn btn-order-thai w-100 py-2 fs-6 fw-bold mb-3">
                                            เข้าสู่ระบบ
                                        </button>

                                        <p class="text-center text-muted small mb-0">
                                            ยังไม่มีบัญชีใช่ไหม?
                                            <a class="auth-switch-link" onclick="switchAuthMode('register')">สมัครสมาชิกใหม่เลย</a>
                                        </p>
                                    </form>

                                    <!-- Register Form -->
                                    <form id="registerForm" class="<%= mode === 'register' ? '' : 'd-none' %>" onsubmit="handleRegister(event)" novalidate>
                                        <div class="mb-3">
                                            <label for="registerName" class="form-label fw-medium small">ชื่อ-นามสกุล <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control auth-input" id="registerName" name="name" placeholder="เช่น สมชาย ใจดี" autocomplete="name" required>
                                        </div>

                                        <div class="row g-3 mb-3">
                                            <div class="col-sm-6">
                                                <label for="registerEmail" class="form-label fw-medium small">อีเมล <span class="text-danger">*</span></label>
                                                <input type="email" class="form-control auth-input" id="registerEmail" name="email" placeholder="name@example.com" autocomplete="email" required>
                                            </div>
                                            <div class="col-sm-6">
                                                <label for="registerPhone" class="form-label fw-medium small">เบอร์โทรศัพท์</label>
                                                <input type="tel" class="form-control auth-input" id="registerPhone" name="phone" placeholder="0812345678" autocomplete="tel">
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label for="registerPassword" class="form-label fw-medium small">รหัสผ่าน <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <input type="password" class="form-control auth-input" id="registerPassword" name="password" placeholder="อย่างน้อย 6 ตัวอักษร" autocomplete="new-password" minlength="6" required>
                                                <button class="btn password-toggle-btn" type="button" aria-label="แสดงรหัสผ่าน" onclick="togglePasswordVisibility('registerPassword', this)">👁️</button>
                                            </div>
                                            <div class="password-strength-bar">
                                                <div class="password-strength-fill" id="passwordStrengthFill"></div>
                                            </div>
                                            <span class="text-muted small d-block mt-1" id="passwordStrengthText">ใช้รหัสผ่านอย่างน้อย 6 ตัวอักษร</span>
                                        </div>

                                        <div class="mb-3">
                                            <label for="registerConfirmPassword" class="form-label fw-medium small">ยืนยันรหัสผ่าน <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <input type="password" class="form-control auth-input" id="registerConfirmPassword" name="confirmPassword" placeholder="กรอกรหัสผ่านอีกครั้ง" autocomplete="new-password" minlength="6" required>
                                                <button class="btn password-toggle-btn" type="button" aria-label="แสดงรหัสผ่าน" onclick="togglePasswordVisibility('registerConfirmPassword', this)">👁️</button>
                                            </div>
                                        </div>

                                        <div class="form-check mb-4">
                                            <input class="form-check-input" type="checkbox" id="acceptTerms" required>
                                            <label class="form-check-label small text-muted" for="acceptTerms">
                                                ฉันยอมรับเงื่อนไขการใช้งานและนโยบายความเป็นส่วนตัวของ Food Hub
                                            </label>
                                        </div>

                                        <button type="submit" class="btn btn-order-thai w-100 py-2 fs-6 fw-bold mb-3">
                                            สมัครสมาชิก
                                        </button>

                                        <p class="text-center text-muted small mb-0">
                                            มีบัญชีอยู่แล้ว?
                                            <a class="auth-switch-link" onclick="switchAuthMode('login')">เข้าสู่ระบบที่นี่</a>
                                        </p>
                                    </form>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script>
        window.__FOODHUB_USER__ = <%- JSON.stringify(currentUser || null).replace(/</g, '\\u003c') %>;
    </script>
    <script src="/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
    <script src="/js/auth.js"></script>
</body>
</html>
